# Copy to .env and replace this placeholder with your Discord webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ID/REPLACE_TOKEN

# Legacy setting, retained for compatibility; token authentication is not implemented here.
GITLAB_SECRET=

# Empty value allows pushes from all branches.
ALLOWED_PUSH_REFS=refs/heads/develop,refs/heads/main
ONLY_MR_NOTES=1
IGNORE_SYSTEM_NOTES=1

# Used for local runs; Compose uses its persistent /app/data volume.
STATE_DB_PATH=data/relay-state.sqlite3
LOG_LEVEL=INFO
